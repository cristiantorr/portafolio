---
// src/components/AIChat.astro
---

<!-- Botón Flotante para abrir/cerrar el Chat -->
<button
  id="toggle-chat-btn"
  type="button"
  aria-label="Abrir chat de IA"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-indigo-600 hover:bg-indigo-500 text-white rounded-full shadow-2xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-indigo-400"
>
  <!-- Ícono de Mensaje/Chat (SVG) -->
  <svg
    id="icon-open"
    class="w-7 h-7"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
    ></path>
  </svg>
  <!-- Ícono de Cerrar (X) - Oculto por defecto -->
  <svg
    id="icon-close"
    class="w-7 h-7 hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<!-- Modal del Chat (Oculto inicialmente) -->
<div
  id="chat-modal"
  class="fixed bottom-24 right-6 z-50 w-96 max-w-[calc(100vw-3rem)] h-[500px] max-h-[80vh] bg-slate-900 border border-slate-800 text-white rounded-2xl shadow-2xl flex flex-col hidden transition-all duration-300 transform scale-95 opacity-0 origin-bottom-right"
>
  <!-- Encabezado del Modal -->
  <div
    class="flex items-center justify-between p-4 border-b border-slate-800 bg-slate-900/80 backdrop-blur rounded-t-2xl"
  >
    <div class="flex items-center gap-3">
      <div class="relative">
        <span class="w-3 h-3 bg-emerald-500 rounded-full inline-block"></span>
        <span
          class="w-3 h-3 bg-emerald-500 rounded-full animate-ping absolute top-0 left-0"
        ></span>
      </div>
      <div>
        <!--  <h3 class="font-semibold text-sm text-slate-100">
          CTR Assistant · Cristian Torres AI
        </h3> -->
        <h3 class="font-semibold text-sm text-slate-100">CTR Assistant</h3>
        <p class="text-xs text-slate-400">
          Asistente Interactivo de Cristian Torres
        </p>
      </div>
    </div>
    <button
      id="close-modal-btn"
      class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors"
      aria-label="Cerrar modal"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Área de Mensajes -->
  <div
    id="chat-box"
    class="flex-1 p-4 overflow-y-auto space-y-3 scrollbar-thin scrollbar-thumb-slate-700"
  >
    <div class="text-left">
      <span
        class="inline-block bg-slate-800 text-slate-200 text-sm px-3.5 py-2.5 rounded-2xl rounded-tl-none border border-slate-700/60 max-w-[85%]"
      >
        ¡Hola! 👋 Soy la IA del portafolio. Pregúntame sobre la experiencia,
        tecnologías o proyectos de Cristian.
      </span>
    </div>
  </div>

  <!-- Formulario de Entrada -->
  <form
    id="chat-form"
    class="p-3 border-t border-slate-800 bg-slate-950/50 rounded-b-2xl flex gap-2"
  >
    <input
      type="text"
      id="user-input"
      placeholder="Escribe tu mensaje..."
      class="flex-1 px-3.5 py-2 bg-slate-800 border border-slate-700 rounded-xl focus:outline-none focus:border-indigo-500 text-sm text-slate-100 placeholder-slate-400 transition-colors"
      required
    />
    <button
      type="submit"
      id="send-btn"
      class="p-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
      </svg>
    </button>
  </form>
</div>

<script>
  /*   const BACKEND_URL = "http://localhost:3000/api/chat";
   */
  // Elementos DOM del Modal
  const toggleBtn = document.getElementById(
    "toggle-chat-btn",
  ) as HTMLButtonElement;
  const closeModalBtn = document.getElementById(
    "close-modal-btn",
  ) as HTMLButtonElement;
  const chatModal = document.getElementById("chat-modal") as HTMLDivElement;
  const iconOpen = document.getElementById("icon-open") as HTMLElement;
  const iconClose = document.getElementById("icon-close") as HTMLElement;

  // Elementos DOM del Chat
  const chatForm = document.getElementById("chat-form") as HTMLFormElement;
  const userInput = document.getElementById("user-input") as HTMLInputElement;
  const chatBox = document.getElementById("chat-box") as HTMLDivElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;

  // Lógica de apertura/cierre del Modal
  function toggleModal() {
    const isHidden = chatModal.classList.contains("hidden");
    if (isHidden) {
      chatModal.classList.remove("hidden");
      setTimeout(() => {
        chatModal.classList.remove("scale-95", "opacity-0");
        chatModal.classList.add("scale-100", "opacity-100");
      }, 10);
      iconOpen.classList.add("hidden");
      iconClose.classList.remove("hidden");
      userInput.focus();
    } else {
      chatModal.classList.remove("scale-100", "opacity-100");
      chatModal.classList.add("scale-95", "opacity-0");
      setTimeout(() => {
        chatModal.classList.add("hidden");
      }, 300);
      iconOpen.classList.remove("hidden");
      iconClose.classList.add("hidden");
    }
  }

  toggleBtn.addEventListener("click", toggleModal);
  closeModalBtn.addEventListener("click", toggleModal);

  // Función para agregar mensajes al chat
  function appendMessage(sender: "user" | "bot", text: string) {
    const msgDiv = document.createElement("div");
    msgDiv.className = sender === "user" ? "text-right" : "text-left";

    const innerBubble = document.createElement("span");
    innerBubble.className =
      sender === "user"
        ? "inline-block bg-indigo-600 text-white text-sm px-3.5 py-2.5 rounded-2xl rounded-tr-none max-w-[85%] text-left shadow-md"
        : "inline-block bg-slate-800 text-slate-200 text-sm px-3.5 py-2.5 rounded-2xl rounded-tl-none max-w-[85%] border border-slate-700/60 shadow-md";

    innerBubble.textContent = text;
    msgDiv.appendChild(innerBubble);
    chatBox.appendChild(msgDiv);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  // Indicador visual de "Escribiendo..."
  function showTypingIndicator() {
    const indicator = document.createElement("div");
    indicator.id = "typing-indicator";
    indicator.className = "text-left";
    indicator.innerHTML = `
      <span class="inline-flex items-center gap-1 bg-slate-800 px-3.5 py-2.5 rounded-2xl rounded-tl-none border border-slate-700/60">
        <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce"></span>
        <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce [animation-delay:0.2s]"></span>
        <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce [animation-delay:0.4s]"></span>
      </span>
    `;
    chatBox.appendChild(indicator);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  function removeTypingIndicator() {
    const indicator = document.getElementById("typing-indicator");
    if (indicator) indicator.remove();
  }

  // Manejar el envío de mensajes
  chatForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const message = userInput.value.trim();
    if (!message) return;

    appendMessage("user", message);
    userInput.value = "";
    userInput.disabled = true;
    sendBtn.disabled = true;

    showTypingIndicator();

    try {
      const backendUrl =
        import.meta.env.PUBLIC_BACKEND_URL || "http://localhost:3000/api/chat";
      console.log("Conectando a:", backendUrl); // <-- 1. Verifica a qué URL está llamando
      const response = await fetch(backendUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message }),
      });

      removeTypingIndicator();

      if (!response.ok) {
        // Si el servidor responde 500 o 404, esto nos dirá qué pasó en el servidor
        const errorData = await response.json();
        console.error("Error devuelto por el servidor:", errorData);
        throw new Error("Respuesta no OK del servidor");
      }

      const data = await response.json();
      appendMessage("bot", data.response);
    } catch (error) {
      removeTypingIndicator();
      console.error("Error:", error);
      appendMessage(
        "bot",
        "No pude conectar con el servidor de IA. Por favor, inténtalo de nuevo más tarde.",
      );
    } finally {
      userInput.disabled = false;
      sendBtn.disabled = false;
      userInput.focus();
    }
  });
</script>
